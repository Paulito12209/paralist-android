# Hostinger (Apache): die App-Dateien richtig ausliefern.
# .webmanifest braucht seinen Typ, sonst nimmt Android das Manifest nicht an;
# version.js darf nie aus dem Zwischenspeicher kommen, damit eine offene App
# eine neue Fassung bemerkt (src/shell/update-prompt.js).
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  <Files "version.js">
    Header set Cache-Control "no-store, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
